{
  "name": "stackchat",
  "version": "1.0.0",
  "private": true,
  "description": "StackChat - AI Chat & Capabilities Workspace",
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "npm --prefix client run build && npm --prefix server run start",
    "dev": "npm --prefix client run build && npm --prefix server run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test:server": "npm --prefix server test"
  }
}
